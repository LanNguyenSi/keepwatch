# keepwatch-managed-unit: written by "keepwatch install" and removed by "keepwatch uninstall"; do not edit, changes are overwritten.
[Unit]
Description=keepwatch periodic check

[Timer]
OnBootSec=5min
OnUnitActiveSec=6h
AccuracySec=1min
Unit=keepwatch-check.service

[Install]
WantedBy=timers.target
