# Image for the sandbox measurement of keepwatch on Ubuntu 22.04: systemd runs as
# PID 1 in it. The base is pinned by the digest of the multi-arch index, as in
# test/e2e.
FROM ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends systemd systemd-sysv \
 && rm -rf /var/lib/apt/lists/*

# A container has no kernel modules. The directory is there so that what
# ProtectKernelModules=yes does to it can be measured.
RUN mkdir -p /usr/lib/modules /opt/keepwatch /out

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
